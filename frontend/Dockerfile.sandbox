FROM node:22.17.0-alpine3.22 AS builder
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build -- --config vite.sandbox.config.ts

FROM nginx:1.28.3-alpine3.23@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
RUN apk del --no-cache nginx-module-acme nginx-module-geoip nginx-module-image-filter nginx-module-njs nginx-module-xslt \
    && apk upgrade --no-cache \
    && apk add --no-cache --upgrade nginx \
    && sed -i '/^user nginx;$/d' /etc/nginx/nginx.conf \
    && rm -f /etc/nginx/http.d/default.conf /etc/nginx/conf.d/default.conf
COPY sandbox-nginx.conf /etc/nginx/http.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html
RUN mkdir -p /var/cache/nginx /run/nginx \
    && chown -R nginx:nginx /var/cache/nginx /run/nginx /etc/nginx/http.d \
    && nginx -t \
    && rm -f /run/nginx/nginx.pid
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
